{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs `jaspr serve` with the debugger attached to the server and the
      // browser app. Needs the Jaspr extension (schultek.jaspr-code).
      // First stops any jaspr processes left from an earlier launch.
      "name": "website",
      "type": "jaspr",
      "request": "launch",
      "cwd": "pkgs/website",
      "preLaunchTask": "stop website"
    },
    {
      // Builds the site and deploys it to Firebase Hosting with
      // pkgs/hosting/deploy.dart. Needs the Firebase CLI, logged in with
      // access to the mish-web project. Runs in a terminal so the CLI can
      // prompt. First stops a running `website` launch, because `jaspr build`
      // can't share the build daemon of `jaspr serve`.
      "name": "deploy",
      "type": "dart",
      "request": "launch",
      "program": "pkgs/hosting/deploy.dart",
      "console": "terminal",
      "preLaunchTask": "stop website"
    }
  ]
}
