{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs `jaspr serve` with the debugger attached to the server and the
      // browser app. Needs the Jaspr extension (schultek.jaspr-code).
      "name": "website",
      "type": "jaspr",
      "request": "launch",
      "cwd": "pkgs/website"
    },
    {
      // Builds the site and deploys it to Firebase Hosting with
      // tool/deploy.dart. Needs the Firebase CLI, logged in with access to
      // the mish-web project. Runs in a terminal so the CLI can prompt.
      "name": "deploy",
      "type": "dart",
      "request": "launch",
      "program": "tool/deploy.dart",
      "console": "terminal"
    }
  ]
}
